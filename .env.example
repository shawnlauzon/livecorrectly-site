# Neon Postgres
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Admin access
ADMIN_PASSWORD=your-secure-password-here

# Maia Mechanics chart generation API (optional — falls back to fake data when unset)
NEXT_PUBLIC_MAIA_API_KEY=

# Booking link (Google Calendar, Calendly, etc.)
NEXT_PUBLIC_BOOKING_URL=

# Email (Resend)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_SENDING_ENABLED=
EMAIL_FROM=Live Correctly <hello@livecorrectly.com>
APP_URL=https://livecorrectly.com
CRON_SECRET=
